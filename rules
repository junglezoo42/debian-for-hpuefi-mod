#!/usr/bin/make -f
#export DH_VERBOSE = 1

include /usr/share/dpkg/pkg-info.mk

pdkms:=hpuefi-dkms
sname:=hpuefi-mod
#$(shell dpkg-parsechangelog --show-field=Version|rev|cut -d- -f2-|rev)

%:
	dh $@

override_dh_auto_clean:
	@echo CLEAN

override_dh_auto_build:
	@echo NO BUILD

override_dh_auto_install:
	@echo NO AUTO INSTALL

override_dh_dkms:
	dh_install -p hpuefi-dkms hpuefi.c-template hpuefi-vm-flags.sh Makefile *.c *.h mkdevhpuefi debian/dkms.post_install usr/src/$(sname)-$(DEB_VERSION)
	dh_install -p hpuefi-udev debian/hpuefi-dev usr/sbin
	chmod 0644 debian/$(pdkms)/usr/src/$(sname)-$(DEB_VERSION)/*
	chmod 0755 debian/$(pdkms)/usr/src/$(sname)-$(DEB_VERSION)/dkms.post_install
	chmod 0755 debian/$(pdkms)/usr/src/$(sname)-$(DEB_VERSION)/hpuefi-vm-flags.sh
	dh_dkms -V $(DEB_VERSION)
